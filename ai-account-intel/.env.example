# Required — get a free key at https://aistudio.google.com
GEMINI_API_KEY=your-key-here

# Optional — defaults shown
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
GEMINI_EXTRA_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest
MAX_RETRIES=3
REQUEST_TIMEOUT_SECONDS=30
RETRY_BASE_WAIT_SECONDS=5
BATCH_DELAY_SECONDS=3
MAX_OUTPUT_TOKENS=8192

# Optional: outside data sources (defaults shown)
# CONTACT_URL is added to the bot's User-Agent (Wikimedia asks automated clients
# for a contact link); leave empty to send none. USER_AGENT replaces it entirely.
CONTACT_URL=
USER_AGENT=
HTTP_TIMEOUT_SECONDS=8
WEBSITE_TIME_BUDGET_SECONDS=12
IP_LOOKUP_TIMEOUT_SECONDS=10
SIDE_LOOKUP_GRACE_SECONDS=12
NEWS_GRACE_SECONDS=15
NEWS_MAX_ITEMS=5
BATCH_MAX_ROWS=25

# Who to contact when visitor behavior doesn't point to a team (the role that usually buys your product)
# DEFAULT_CONTACT_ROLE=Head of Sales
